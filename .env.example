# Template for .env (gitignored). Copy to .env and fill in the secrets.
# Every variable is described in docs/tech.md «Environment variables».

# User and password of the PostgreSQL container (docker-compose.yml)
POSTGRES_USER=vibecoding
POSTGRES_PASSWORD=change-me

# Dev database
DATABASE_URL=postgresql+psycopg://vibecoding:change-me@localhost:5432/vibecoding

# Test database; the TDD sandbox adds a suffix to its name
TEST_DATABASE_URL=postgresql+psycopg://vibecoding:change-me@localhost:5432/vibecoding_test

# Host port of the PostgreSQL container (docker-compose.yml); change when 5432 is taken
# (then also change the port in DATABASE_URL and TEST_DATABASE_URL above)
POSTGRES_PORT=5432

# Base URL of the SPA: the origin of links in emails and the allowed Origin of state-changing requests
APP_BASE_URL=http://localhost:5173

# Sender address and SMTP server of service emails (dev: the Mailpit container, UI on http://localhost:8025)
MAIL_FROM=VibeCoding <no-reply@vibecoding.local>
SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false

# Session cookie `Secure` flag: false in dev (http), true behind https
# SESSION_COOKIE_SECURE=false

# Lifetimes and the sign-in lock (defaults shown)
# SESSION_LIFETIME_DAYS=14
# CONFIRMATION_LINK_HOURS=24
# PASSWORD_RESET_LINK_MINUTES=60
# SIGN_IN_MAX_FAILURES=5
# SIGN_IN_FAILURE_WINDOW_MINUTES=15
# SIGN_IN_LOCK_MINUTES=15

# Fernet key that encrypts mailbox passwords (required). Generate one with:
#   uv run --directory backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes every connected mailbox ask for a new app password.
MAILBOX_ENCRYPTION_KEY=

# Mailbox reading (defaults shown)
# MAILBOX_READING_ENABLED=true
# MAILBOX_READ_INTERVAL_MINUTES=5
# MAILBOX_READ_TICK_SECONDS=10
# MAILBOX_READ_DEPTH_DAYS=365
# IMAP_TIMEOUT_SECONDS=30
# Comma-separated IMAP hosts reached without TLS; local test servers only (compose sets `greenmail`)
# IMAP_INSECURE_HOSTS=

# Password of the two demo mailboxes anna@demo.test and anna.work@demo.test on the GreenMail
# container (docker-compose.yml); `just demo-mail` loads the prepared emails into them
DEMO_MAIL_PASSWORD=demo-password
# Host and IMAP port of the demo mail server for scripts/demo_mail.py (defaults shown)
# DEMO_MAIL_HOST=localhost
# DEMO_MAIL_PORT=3143

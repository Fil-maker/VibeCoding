# Template for .env (gitignored). Copy to .env and fill in the secrets.
# Every variable is described in docs/tech.md «Environment variables».

# User and password of the PostgreSQL container (docker-compose.yml, task 0.1)
POSTGRES_USER=vibecoding
POSTGRES_PASSWORD=change-me

# Dev database
DATABASE_URL=postgresql+psycopg://vibecoding:change-me@localhost:5432/vibecoding

# Test database; the TDD sandbox adds a suffix to its name
TEST_DATABASE_URL=postgresql+psycopg://vibecoding:change-me@localhost:5432/vibecoding_test

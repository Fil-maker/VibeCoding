{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spa (docker compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--build"],
      "port": 5173
    },
    {
      "name": "spa (docker compose, local images)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "--no-build"],
      "port": 5173
    },
    {
      "name": "spa (local vite, backend in docker)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "exec", "vite", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
